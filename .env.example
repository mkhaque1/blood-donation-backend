# Environment variables for Blood Donation Backend

PORT=8000
NODE_ENV=development  # development | production

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection string (Neon, Supabase, Railway, etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# =============================================================================
# JWT
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# =============================================================================
JWT_ACCESS_SECRET=your_access_secret_here
JWT_ACCESS_EXPIRES_IN=15m   # e.g. 15m, 1h, 1d

JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d   # e.g. 7d, 30d

# =============================================================================
# STRIPE
# Get keys from: https://dashboard.stripe.com/apikeys
# Get webhook secret by running: stripe listen --forward-to localhost:8000/api/v1/payments/webhook
# =============================================================================
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here   # from stripe listen output
PRIORITY_REQUEST_FEE_CENTS=500   # $5.00 default

# =============================================================================
# SEED ACCOUNTS (optional — used by: npm run prisma:seed)
# =============================================================================
ADMIN_SEED_EMAIL=admin@blooddonation.test
ADMIN_SEED_PASSWORD=ChangeMe123!
